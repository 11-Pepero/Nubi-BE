# 서버의 배포 폴더에 .env 로 복사해 값을 채운다. 이 파일에는 실제 값을 넣지 않는다.

# 앱이 열 포트 (서버 바깥 포트)
APP_PORT=8080

# DB (compose 안의 PostGIS)
DB_NAME=nubi
DB_USERNAME=nubi
DB_PASSWORD=

# Redis
REDIS_PASSWORD=

# JWT 서명 키 (Base64, 256비트 이상). 만들기: openssl rand -base64 48
JWT_SECRET_KEY=

# 프론트 주소. 여러 개면 쉼표로
CORS_ALLOWED_ORIGINS=https://example.com

# 외부 API 키
DATA_GO_KR_SERVICE_KEY=
BARRIER_FREE_SERVICE_KEY=
KAKAO_REST_API_KEY=
OPENAI_API_KEY=
GG_DATA_KEY=

# 공공데이터 수집 (매일 새벽 5시)
COLLECT_ENABLED=true
COLLECT_RUN_ON_STARTUP=false

# prod는 테이블을 검사만 한다(validate). 빈 DB에 처음 배포할 때만 update 로 두어 테이블을 만들고,
# 첫 배포가 끝나면 이 줄을 지운다.
SPRING_JPA_HIBERNATE_DDL_AUTO=update
